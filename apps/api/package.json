{
  "name": "@github-intelligence/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "type-check": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config jest.config.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@github-intelligence/api-contracts": "*",
    "@github-intelligence/members": "*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@github-intelligence/tsconfig": "*",
    "@nestjs/testing": "12.1.3",
    "@types/node": "22.19.17",
    "@types/supertest": "7.2.1",
    "concurrently": "9.2.5",
    "supertest": "7.3.1",
    "typescript": "5.7.3"
  }
}
