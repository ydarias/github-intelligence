{
  "name": "@github-intelligence/reporter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "lint": "eslint src",
    "build": "tsc -p tsconfig.server.json",
    "type-check": "tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config jest.config.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@github-intelligence/issues": "*",
    "@github-intelligence/members": "*",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@github-intelligence/tsconfig": "*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
